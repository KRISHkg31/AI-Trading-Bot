# Copy to `.env` and fill in ONLY when going live / paper trading.
# None of these are required for development (backtest uses public data).
# Values are injected via environment; they are never committed and never logged.

# --- Crypto: Binance (public market data needs NO key; trading/testnet needs these) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_TESTNET=true

# --- Crypto: Coinbase Advanced (optional second exchange) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# --- US Equities: Alpaca (free paper account gives you keys immediately) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
# ALPACA_PAPER=true

# --- Indian Equities: Zerodha Kite Connect (account + KYC required) ---
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
# ZERODHA_ACCESS_TOKEN=

# --- Aux: alerts (Phase 5; optional during dev) ---
# TELEGRAM_BOT_TOKEN=
# SLACK_WEBHOOK_URL=

# --- Aux: LLM signal generation (Phase 4; optional) ---
# ANTHROPIC_API_KEY=

# --- Runtime overrides (optional) ---
# AIBOT_ENVIRONMENT=dev        # dev | backtest | paper | live
# AIBOT_EXECUTION__MODE=paper  # live | paper | dry_run